---
/**
 * Inlines an SVG from src/icons/ so it inherits the surrounding text color.
 * Add a new icon by dropping a 24x24 SVG into src/icons/ and referencing its
 * filename (without extension) from data files or components.
 */
interface Props {
  name: string;
  size?: number;
}

const { name, size = 22 } = Astro.props;

const icons = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

let svg = icons[`../icons/${name}.svg`];
if (!svg) throw new Error(`Icon "${name}" not found in src/icons/`);

const fill = svg.includes('fill=') ? '' : 'fill="currentColor" ';
svg = svg.replace(
  '<svg ',
  `<svg ${fill}width="${size}" height="${size}" aria-hidden="true" focusable="false" `
);
---

<Fragment set:html={svg} />
