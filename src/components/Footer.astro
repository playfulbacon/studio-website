---
import { SITE } from '../data/site';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer" id="contact">
  <div class="container">
    <h2>Get in touch</h2>
    <p>
      Questions, press, or just want to say hi? Email us at
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
    <SocialLinks />
    <ul class="legal">
      <li><a href={`${base}/wordbound-privacy-policy/`}>Wordbound Privacy Policy</a></li>
      <li><a href={`${base}/accessibility-statement/`}>Accessibility</a></li>
    </ul>
    <p class="copyright">© {year} {SITE.copyrightHolder}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    background: var(--navy-deep);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  h2 {
    font-size: var(--text-lg);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .legal a {
    color: var(--ink-dim);
  }

  .copyright {
    margin-top: 2rem;
    margin-bottom: 0;
    font-size: var(--text-sm);
    color: var(--ink-dim);
  }
</style>
