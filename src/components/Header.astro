---
import { Image } from 'astro:assets';
import logo from '../assets/kettle-logo.png';

// Nav anchors live on the homepage; prefix with the base so links also work
// from subpages like the privacy policy.
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

const nav = [
  { label: 'About', href: `${home}#about` },
  { label: 'Games', href: `${home}#games` },
  { label: 'FAQ', href: `${home}#faq` },
  { label: 'Team', href: `${home}#team` },
  { label: 'Contact', href: `${home}#contact` },
];
---

<header class="site-header">
  <div class="container inner">
    <a class="logo-link" href={home}>
      <Image src={logo} alt="Kettle Games — home" width={140} densities={[1, 2]} loading="eager" />
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(0, 34, 81, 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.75rem;
  }

  .logo-link img {
    width: clamp(96px, 12vw, 140px);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  nav a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
  }

  @media (max-width: 560px) {
    .inner {
      justify-content: center;
    }
  }
</style>
